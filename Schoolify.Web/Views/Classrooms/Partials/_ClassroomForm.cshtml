@using Schoolify.Common.DTOs.Classroom
@model ClassroomDTO

@using Schoolify.Common
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

<div class="row g-3">

    <div class="col-md-6">
        <label asp-for="NameEn"></label>
        <input asp-for="NameEn" class="form-control" />
        <span asp-validation-for="NameEn" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="NameAr"></label>
        <input asp-for="NameAr" class="form-control" />
        <span asp-validation-for="NameAr" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Capacity"></label>
        <input asp-for="Capacity" class="form-control" />
        <span asp-validation-for="Capacity" class="text-danger"></span>
    </div>

    <div class="mb-3 col-md-6">
        <label asp-for="RoomTypeId" class="form-label"></label>
        <select asp-for="RoomTypeId"
                class="form-control"
                asp-items="ViewBag.ClassroomTypes">
            <option selected disabled value="">@Localizer["SelectRoomType"]</option>
        </select>
        <span asp-validation-for="RoomTypeId" class="text-danger"></span>
    </div>
</div>