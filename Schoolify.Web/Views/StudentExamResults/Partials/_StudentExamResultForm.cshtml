@using Schoolify.Common.DTOs.Exam
@model ExamDTO

@using System.Globalization

@using Schoolify.Common
@using Microsoft.Extensions.Localization
@using Schoolify.Common.DTOs.StudentExamResult
@inject IStringLocalizer<SharedResource> Localizer

<div class="row">

    <h5 class="col-12">@Localizer["Exam"]</h5>
    <input type="hidden" asp-for="Id" />
    <hr class="col-12" />

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["NameEn"]</label>
        <div>@Model.NameEn</div>
    </div>

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["NameAr"]</label>
        <div>@Model.NameAr</div>
    </div>

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["MaxScore"]</label>
        <div>@Model.MaxScore</div>
    </div>

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["Date"]</label>
        <div>@Model.Date.ToString("d", CultureInfo.CurrentCulture)</div>
    </div>

    <hr class="col-12 my-2" />

    <div class="col-12">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        @* <th>#</th> *@
                        <th>@Localizer["Student"]</th>
                        <th>@Localizer["MarksObtained"]</th>
                    </tr>
                </thead>

                <tbody>

                    @for (int i = 0; i < Model?.StudentExamResults?.Count; i++)
                    {
                        <tr>
                            <td>
                                @Model?.StudentExamResults[i]?.Student?.FullName

                                <input asp-for="StudentExamResults[i].Id" type="hidden" />
                                <input asp-for="StudentExamResults[i].StudentId" type="hidden" />
                            </td>
                            <td>
                                <input asp-for="StudentExamResults[i].MarksObtained" type="number" class="form-control" />
                                <span asp-validation-for="StudentExamResults[i].MarksObtained" class="text-danger"></span>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>