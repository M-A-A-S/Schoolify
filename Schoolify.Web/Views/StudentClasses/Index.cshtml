@using Schoolify.Common.DTOs.StudentClass
@model StudentClassListDTO

@using Schoolify.Common
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@using System.Globalization


<div class="card row">
    <div class="mb-3 col-md-6">
        <label asp-for="SubjectClassId" class="form-label"></label>
        <select asp-for="SubjectClassId"
                class="form-control"
                id="subjectClassId"
                asp-items="ViewBag.SubjectClasses">
            <option selected disabled value="">@Localizer["SelectClass"]</option>
        </select>
        <span asp-validation-for="SubjectClassId" class="text-danger"></span>
    </div>
</div>



<div class="d-flex align-items-center justify-content-between my-4">
    <h2>@Localizer["StudentClasses"]</h2>

    <a id="createLink"
        asp-action="Create"
       asp-route-subjectClassId="@Model.SubjectClassId"
       class="btn btn-primary">
        <i class="fa fa-plus me-1"></i>
        @Localizer["CreateNew"]
    </a>
</div>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>@Localizer["Class"]</th>
                <th>@Localizer["Student"]</th>
                <th>@Localizer["Actions"]</th>
                <th></th>
            </tr>
        </thead>

        <tbody id="tableBody">
            @foreach (var item in Model.StudentClasses)
            {
                <tr>
                <td>
                        @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
                                            ? item?.SubjectClass?.NameAr
                                            : item?.SubjectClass?.NameEn)
                </td>
                <td>
					@item?.Student?.FullName
                </td>

                    <td style="display: flex; gap: 4px">
                        @* <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-icon btn-outline-primary tooltip-btn"
                           data-tooltip="@Localizer["Edit"]">
                            <i class="fa fa-pen"></i>
                        </a> *@
                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-icon btn-outline-info tooltip-btn"
                           data-tooltip="@Localizer["Details"]">
                            <i class="fa fa-info"></i>
                        </a>
                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-icon btn-outline-danger tooltip-btn"
                           data-tooltip="@Localizer["Delete"]">
                            <i class="fa fa-trash"></i>
                        </a>
                    </td>
                </tr>
                        }
        </tbody>
    </table>
</div>


@section Scripts
{
    <script>

        const localizedStrings = {
            details: "@Localizer["Details"]",
            edit: "@Localizer["Edit"]",
            delete: "@Localizer["Delete"]",
        };

        const isArabic = '@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName' === 'ar';

        $(document).ready(function () {
            $("#subjectClassId").change(function () {
            
            const subjectClassId = $(this).val();

            $("#createLink").attr("href", `StudentClasses/Create?subjectClassId=${subjectClassId}`)

            if (!subjectClassId)
            {
                return;
            }

            $.ajax({
                url: '/StudentClasses/GetClassStudents',
                type: 'GET',
                data: {
                    subjectClassId: subjectClassId,
                },
                success: function (res) {
                    console.log(res)

                    if (!res.studentClasses.length)
                    {
                        $("#tableBody").html("");
                        return;
                    }

                    let rows = "";

                    $.each(res.studentClasses, function (i, item) {

                        rows += `
                        <tr>
                            <th>${isArabic ? item.subjectClass.nameAr : item.subjectClass.nameEn}</td>
                            <th>${item.student.fullName}</td>
                            <td style="display: flex; gap: 4px">
                            <!--
                        <a 
                           href="StudentClasses/Edit/${item.id}"
                           class="btn btn-icon btn-outline-primary tooltip-btn"
                           data-tooltip="${localizedStrings.edit}">
                            <i class="fa fa-pen"></i>
                        </a>
                        -->
                        <a
                           href="StudentClasses/Details/${item.id}"
                           class="btn btn-icon btn-outline-info tooltip-btn"
                           data-tooltip="${localizedStrings.details}">
                            <i class="fa fa-info"></i>
                        </a>
                        <a 
                           href="StudentClasses/Edit/${item.id}"
                           class="btn btn-icon btn-outline-danger tooltip-btn"
                           data-tooltip="${localizedStrings.delete}">
                            <i class="fa fa-trash"></i>
                        </a>
                    </td>
                        </tr>
                        `
                    });

					$("#tableBody").html(rows);
                },
                error: function (xhr, status, error) {
                        console.error('Error loading students:', error);
                }
                })

        })
        })

    </script>
}