@using Schoolify.Common.DTOs.Section
@model SectionDTO

@using System.Globalization

@using Microsoft.Extensions.Localization
@using Schoolify.Common
@inject IStringLocalizer<SharedResource> Localizer

<div class="row">

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["NameEn"]</label>
        <div>@Model.NameEn</div>
    </div>

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["NameAr"]</label>
        <div>@Model.NameAr</div>
    </div>

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["YearLevel"]</label>
        <div>
            @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
                        ? @Model?.YearLevel?.NameAr
                        : @Model?.YearLevel?.NameEn)
        </div>
    </div>

</div>