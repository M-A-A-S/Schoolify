@using Schoolify.Common.DTOs.YearLevel;
@model YearLevelDTO

@using Schoolify.Common
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

<div class="row g-3">

    <div class="col-md-6">
        <label asp-for="NameEn"></label>
        <input asp-for="NameEn" class="form-control" />
        <span asp-validation-for="NameEn" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="NameAr"></label>
        <input asp-for="NameAr" class="form-control" />
        <span asp-validation-for="NameAr" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="LevelOrder"></label>
        <input asp-for="LevelOrder" class="form-control" />
        <span asp-validation-for="LevelOrder" class="text-danger"></span>
    </div>

    <div class="mb-3 col-md-6">
        <label asp-for="SchoolStageId" class="form-label"></label>
        <select asp-for="SchoolStageId"
                class="form-control"
                asp-items="ViewBag.SchoolStages">
            <option selected disabled value="">@Localizer["SelectSchoolStage"]</option>
        </select>
        <span asp-validation-for="SchoolStageId" class="text-danger"></span>
    </div>
</div>