@using Schoolify.Common.DTOs.YearLevel;
@model YearLevelDTO

@using System.Globalization

@using Microsoft.Extensions.Localization
@using Schoolify.Common
@inject IStringLocalizer<SharedResource> Localizer

<div class="row">

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["NameEn"]</label>
        <div>@Model.NameEn</div>
    </div>

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["NameAr"]</label>
        <div>@Model.NameAr</div>
    </div>

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["LevelOrder"]</label>
        <div>@Model.LevelOrder</div>
    </div>

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["SchoolStage"]</label>
        <div>
            @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
                        ? @Model.SchoolStage.NameAr
                        : @Model.SchoolStage.NameEn)
        </div>
    </div>

</div>