@using Schoolify.Common.Enums;

@using Schoolify.Common.DTOs.Subject;
@model SubjectDTO

@using Schoolify.Common
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

<div class="row g-3">

    <div class="col-md-6">
        <label asp-for="NameEn"></label>
        <input asp-for="NameEn" class="form-control" />
        <span asp-validation-for="NameEn" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="NameAr"></label>
        <input asp-for="NameAr" class="form-control" />
        <span asp-validation-for="NameAr" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DepartmentId" class="form-label"></label>
        <select asp-for="DepartmentId"
                class="form-control"
                asp-items="ViewBag.Departments">
            <option selected disabled value="">@Localizer["SelectDepartment"]</option>
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>
</div>