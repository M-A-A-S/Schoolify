@using Schoolify.Common.DTOs.Exam
@model ExamDTO

@using Schoolify.Common
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

<div class="row g-3">

    <div class="col-md-6">
        <label asp-for="NameEn"></label>
        <input asp-for="NameEn" class="form-control" />
        <span asp-validation-for="NameEn" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="NameAr"></label>
        <input asp-for="NameAr" class="form-control" />
        <span asp-validation-for="NameAr" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="MaxScore"></label>
        <input asp-for="MaxScore" type="number" class="form-control" />
        <span asp-validation-for="MaxScore" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Date"></label>
        <input asp-for="Date" type="date" class="form-control" />
        <span asp-validation-for="Date" id="end-date-validation" class="text-danger"></span>
    </div>

    <div class="mb-3 col-md-6">
        <label asp-for="SubjectClassId" class="form-label"></label>
        <select asp-for="SubjectClassId"
                class="form-control"
                asp-items="ViewBag.SubjectClasses">
            <option selected disabled value="">@Localizer["SelectClass"]</option>
        </select>
        <span asp-validation-for="SubjectClassId" class="text-danger"></span>
    </div>
</div>