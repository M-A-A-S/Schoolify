@using Schoolify.Common.DTOs.Guardian;
@model GuardianDTO

<div class="row">

    <div class="col-md-3 mb-3">
        <label class="fw-bold">First Name</label>
        <div>@Model.FirstName</div>
    </div>

    <div class="col-md-3 mb-3">
        <label class="fw-bold">Second Name</label>
        <div>@Model.SecondName</div>
    </div>

    <div class="col-md-3 mb-3">
        <label class="fw-bold">Third Name</label>
        <div>@Model.ThirdName</div>
    </div>

    <div class="col-md-3 mb-3">
        <label class="fw-bold">Fourth Name</label>
        <div>@Model.ForthName</div>
    </div>

    <div class="col-md-4 mb-3">
        <label class="fw-bold">Phone Number</label>
        <div>@Model.PhoneNumber</div>
    </div>

    <div class="col-md-6 mb-3">
        <label class="fw-bold">Email</label>
        <div>@Model.EmailAddress</div>
    </div>

</div>