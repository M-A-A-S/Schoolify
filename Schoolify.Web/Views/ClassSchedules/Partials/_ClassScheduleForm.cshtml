@using Schoolify.Common.DTOs.ClassSchedule
@model ClassScheduleUpsertDTO

@using Schoolify.Common
@using Microsoft.Extensions.Localization
@using System.Globalization
@inject IStringLocalizer<SharedResource> Localizer

<div class="row g-3">

    <!-- SUBJECT CLASS -->
    <div class="mb-3 col-md-6">
        <label asp-for="ClassSchedule.SubjectClassTeacher.SubjectClassId" class="form-label"></label>

        <select asp-for="ClassSchedule.SubjectClassTeacher.SubjectClassId"
                id="SubjectClassId"
                class="form-control"
                asp-items="@(Model?.Classes?.Select(t => new SelectListItem
                {
                    Value = t.Id.ToString(),
                    Text = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
                                                                        ? t.NameAr
                                                                        : t.NameEn
                }))">

            <option selected disabled value="">
                @Localizer["SelectClass"]
            </option>

        </select>

        <span asp-validation-for="ClassSchedule.SubjectClassTeacher.SubjectClassId" class="text-danger"></span>
    </div>

    <!-- TEACHER  -->
    <div class="mb-3 col-md-6">
        <label asp-for="ClassSchedule.SubjectClassTeacher.TeacherId"></label>

        <select asp-for="ClassSchedule.SubjectClassTeacher.TeacherId"
                id="SubjectClassTeacherId"
                class="form-control" 
                asp-items="@(Model?.SubjectClassTeachers?.Select(t => new SelectListItem
                {
                    Value = t.Teacher.Id.ToString(),
                    Text = $"{t.Teacher.FirstName} {t.Teacher.SecondName} {t.Teacher.ThirdName} {t.Teacher.ForthName}"
                }))"
                >

            <option value="">@Localizer["SelectTeacher"]</option>



        </select>

        <span asp-validation-for="ClassSchedule.SubjectClassTeacher.TeacherId" class="text-danger"></span>
    </div>

    <!-- SECTION -->
    <div class="mb-3 col-md-6">
        <label asp-for="ClassSchedule.SectionId" class="form-label"></label>

        <select asp-for="ClassSchedule.SectionId"
                class="form-control"
                asp-items="@(Model?.Sections?.Select(s => new SelectListItem
                {
                    Value = s.Id.ToString(),
                    Text = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
                                        ? s.NameAr
                                        : s.NameEn
                }))">

            <option value="">@Localizer["SelectSection"]</option>

        </select>

        <span asp-validation-for="ClassSchedule.SectionId" class="text-danger"></span>
    </div>

    <!-- Period -->
    <div class="mb-3 col-md-6">
        <label asp-for="ClassSchedule.PeriodId" class="form-label"></label>

        <select asp-for="ClassSchedule.PeriodId"
                class="form-control"
                asp-items="@(Model?.Periods?.Select(t => new SelectListItem
                {
                    Value = t.Id.ToString(),
                    Text = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
                                                                                        ? t.NameAr
                                                                                        : t.NameEn
                }))">

            <option selected disabled value="">
                @Localizer["SelectPeriod"]
            </option>

        </select>

        <span asp-validation-for="ClassSchedule.PeriodId" class="text-danger"></span>
    </div>

    <!-- Classroom -->
    <div class="mb-3 col-md-6">
        <label asp-for="ClassSchedule.ClassroomId" class="form-label"></label>

        <select asp-for="ClassSchedule.ClassroomId"
                class="form-control"
                asp-items="@(Model?.Classrooms?.Select(t => new SelectListItem
                {
                    Value = t.Id.ToString(),
                    Text = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
                                                                                        ? t.NameAr
                                                                                        : t.NameEn
                }))">

            <option selected disabled value="">
                @Localizer["SelectClassroom"]
            </option>

        </select>

        <span asp-validation-for="ClassSchedule.ClassroomId" class="text-danger"></span>
    </div>

    <!-- DayOfWeek -->
    <div class="col-md-4">
        <label asp-for="ClassSchedule.DayOfWeek" class="form-label"></label>
        <select asp-for="ClassSchedule.DayOfWeek" class="form-select"
                asp-items="@(new SelectList(Model.Days, "Id", "Name"))">
            <option value="" disabled selected>@Localizer["SelectDay"]</option>
        </select>
        <span asp-validation-for="ClassSchedule.DayOfWeek" class="text-danger"></span>
    </div>



</div>

<script>
    document.getElementById("SubjectClassId").addEventListener("change", function () {

        var subjectClassId = this.value;

        var teacherSelect = document.getElementById("SubjectClassTeacherId");

        teacherSelect.innerHTML = '<option>Loading...</option>';

        fetch(`/ClassSchedules/GetTeachersBySubjectClass?subjectClassId=${subjectClassId}`)
            .then(res => res.json())
            .then(data => {

                // teacherSelect.innerHTML = '<option selected disabled value="">Select Teacher</option>';
                teacherSelect.innerHTML = '<option selected disabled value="">@Localizer["SelectTeacher"]</option>';

                data.forEach(t => {
                    console.log(t)

                    teacherSelect.innerHTML +=
                        `<option value="${t.teacher.id}">${t.teacher.firstName} ${t.teacher.secondName} ${t.teacher.thirdName} ${t.teacher.forthName}</option>`;
                });
            });
    });
</script>