@using Schoolify.Common.DTOs.ClassSchedule
@model ScheduleDTO

@using Microsoft.Extensions.Localization
@using Schoolify.Common
@using System.Globalization
@inject IStringLocalizer<SharedResource> Localizer

<style>
    /* .schedule-table td, .schedule-table th {
        text-align: center;
        vertical-align: middle;
    }

    .schedule-box {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 10px;
        font-size: 13px;
    }

    .schedule-title {
        font-weight: bold;
        color: #0d6efd;
    } */


</style>

<div class="container my-4">

    <h2 class="text-center mb-4">
        📅 @Localizer["ScheduleTitle"]
    </h2>

    <div class="table-responsive">

        @* <table class="table table-bordered schedule-table"> *@
        <table class="table ">

            <!-- HEADER -->
            @* <thead class="table-dark"> *@
            <thead>
                <tr>
                    <th>@Localizer["Period"]</th>

                    @foreach (var day in Model.Days)
                    {
                        <th>
                            @switch (day)
                            {
                                case DayOfWeek.Monday:
                                    @Localizer["Monday"]
                                    ; break;
                                case DayOfWeek.Tuesday:

                                    @Localizer["Tuesday"]
                                    ; break;
                                case DayOfWeek.Wednesday:

                                    @Localizer["Wednesday"]
                                    ; break;
                                case DayOfWeek.Thursday:

                                    @Localizer["Thursday"]
                                    ; break;
                                case DayOfWeek.Friday:

                                    @Localizer["Friday"]
                                    ; break;
                                case DayOfWeek.Saturday:

                                    @Localizer["Saturday"]
                                    ; break;
                                case DayOfWeek.Sunday:

                                    @Localizer["Sunday"]
                                    ; break;
                                default:

                                    @day.ToString()
                                    ; break;
                            }
                        </th>
                    }
                </tr>
            </thead>

            <!-- BODY -->
            <tbody>
                @foreach (var period in Model.Periods)
                {
                    <tr>

                        <!-- PERIOD INFO -->
                        <td>
                            <strong>
                                @* @period.NameEn *@
                                @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
                                                            ? period?.NameAr
                                                            : period?.NameEn)
                            </strong>
                            <br />
                            <small class="text-muted">
                                @Localizer["StartTime"]: @period.StartTime <br />
                                @Localizer["EndTime"]: @period.EndTime
                            </small>
                        </td>

                        <!-- DAYS -->
                        @foreach (var day in Model.Days)
                        {
                            var cell = Model.Grid[period.Id][day];

                            <td>
                                @if (cell != null)
                                {
                                    <div class="schedule-box">

                                        <div class="schedule-title">
                                            @* @cell.ClassName *@
                                            @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
                                                                            ? cell?.ClassNameAr
                                                                         : cell?.ClassNameEn)
                                        </div>

                                        <div>
                                            @* 👨‍🏫 @Localizer["Teacher"]: @cell.TeacherName *@
                                            <i class="fa-solid fa-chalkboard-user"></i> @Localizer["Teacher"]: @cell.TeacherName
                                        </div>

                                        <div>
                                            @* 🏫 @Localizer["Classroom"]: @cell.ClassroomName *@
                                            @* 🏫 @Localizer["Classroom"]: @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
                                                                ? cell?.ClassroomNameAr
                                                                : cell?.ClassroomNameEn) *@
                                            <i class="fa-solid fa-door-open"></i> @Localizer["Classroom"]: @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
                                                                ? cell?.ClassroomNameAr
                                                                : cell?.ClassroomNameEn)
                                        </div>

                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        @Localizer["NoClass"]
                                    </span>
                                }
                            </td>
                        }

                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>