@using Schoolify.Common.DTOs.ClassSchedule
@model IEnumerable<SectionScheduleDTO>

@using Microsoft.Extensions.Localization
@using Schoolify.Common
@using System.Globalization
@inject IStringLocalizer<SharedResource> Localizer

<div class="d-flex align-items-center justify-content-between my-4">
	<h2>@Localizer["ClassSchedules"]</h2>

	<a asp-action="Create" class="btn btn-primary">
		<i class="fa fa-plus me-1"></i>
		@Localizer["CreateNew"]
	</a>
</div>

@foreach (var section in Model)
{
	<h3 class="mb-3">
		@Localizer["Section"]: @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
									? section.SectionNameAr
									: section.SectionNameEn)
	</h3>

	<div class="table-responsive">
		<table class="table ">

			<!-- HEADER -->
			<thead>
				<tr>
				<th>@Localizer["Period"]</th>
				@foreach (var day in section.Days)
					{
						<th>
							@switch (day)
							{
								case DayOfWeek.Monday:
									@Localizer["Monday"]
									; break;
								case DayOfWeek.Tuesday:

									@Localizer["Tuesday"]
									; break;
								case DayOfWeek.Wednesday:

									@Localizer["Wednesday"]
									; break;
								case DayOfWeek.Thursday:

									@Localizer["Thursday"]
									; break;
								case DayOfWeek.Friday:

									@Localizer["Friday"]
									; break;
								case DayOfWeek.Saturday:

									@Localizer["Saturday"]
									; break;
								case DayOfWeek.Sunday:

									@Localizer["Sunday"]
									; break;
								default:

									@day.ToString()
									; break;
							}
						</th>
					}
				</tr>
			</thead>

			<!-- BODY -->
			<tbody>
				@foreach (var period in section.Periods)
				{
					<tr>

						<!-- PERIOD INFO -->
						<td>
							<strong>
								@* @period.NameEn *@
								@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
														? period?.NameAr
														: period?.NameEn)
					</strong>
					<br />
					<small class="text-muted">
						@Localizer["StartTime"]: @period.StartTime <br />
						@Localizer["EndTime"]: @period.EndTime
					</small>
				</td>

						<!-- DAYS -->
				@foreach (var day in section.Days)
						{
							var cell = section.Grid[period.Id][day];

							<td>
								@if (cell != null)
								{
									<div class="schedule-box"
										 @* onclick="editSchedule(@cell.ClassScheduleId)" *@
										 onclick="showScheduleDetails(@cell.ClassScheduleId)"
										 style="cursor:pointer;">

										<div class="schedule-title">
											@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
																		? cell?.ClassNameAr
																		: cell?.ClassNameEn)
																						</div>

										<div>
											<i class="fa-solid fa-chalkboard-user"></i>
											@Localizer["Teacher"]: @cell.TeacherName
										</div>

										<div>
											<i class="fa-solid fa-door-open"></i>
											@Localizer["Classroom"]:
											@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
																		? cell?.ClassroomNameAr
																		: cell?.ClassroomNameEn)
						</div>


										<div style="display: flex; gap: 4px">
											<a asp-action="Edit"
											   asp-route-id="@cell.ClassScheduleId"
											   class="btn btn-icon btn-outline-primary tooltip-btn"
											   data-tooltip="@Localizer["Edit"]">
												<i class="fa fa-pen"></i>
											</a>
											<a asp-action="Details"
											   asp-route-id="@cell.ClassScheduleId"
											   class="btn btn-icon btn-outline-info tooltip-btn"
											   data-tooltip="@Localizer["Details"]">
												<i class="fa fa-info"></i>
											</a>
											<a asp-action="Delete"
											   asp-route-id="@cell.ClassScheduleId"
											   class="btn btn-icon btn-outline-danger tooltip-btn"
											   data-tooltip="@Localizer["Delete"]">
												<i class="fa fa-trash"></i>
											</a>
										</div>

									</div>
										}
								else
								{
									<div onclick="createSchedule(@period.Id, @((int)day), @(section.SectionId))"
										 style="cursor:pointer; min-height:60px;"
										 class="text-muted d-flex align-items-center justify-content-center">
										+ @Localizer["NoClass"]
									</div>
								}
							</td>
						}

					</tr>
				}
			</tbody>

		</table>
	</div>

}



<script>

	function createSchedule(periodId, dayId, sectionId) {
		window.location.href =
			`/ClassSchedules/Create?periodId=${periodId}&dayId=${dayId}&sectionId=${sectionId}`;
	}

	function editSchedule(id) {
		window.location.href =
			`/ClassSchedules/Edit/${id}`;
	}

		function showScheduleDetails(id) {
		window.location.href =
			`/ClassSchedules/Details/${id}`;
	}
</script>