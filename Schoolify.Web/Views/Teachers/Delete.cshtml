@using Schoolify.Common.DTOs.Teacher;
@model TeacherDTO
@using Microsoft.Extensions.Localization;
@using Schoolify.Common;
@inject IStringLocalizer<SharedResource> Localizer
@using Schoolify.Common.Enums

<div class="card shadow-sm border-0">

    <div class="card-header text-white">
        <h5 class="mb-0">
            @Localizer["Delete"] @Localizer["Teacher"]
        </h5>
    </div>

    <div class="card-body">

        <div class="alert alert-warning">
            @Localizer["DeleteConfirmationMessage"]
        </div>

        <div class="mb-3">
            <strong>@Localizer["FullName"]:</strong>
            <span>
                @Model.FirstName @Model.SecondName @Model.ThirdName @Model.ForthName
            </span>
        </div>

        <div class="mb-3">
            <strong>@Localizer["Email"]:</strong>
            <span>@Model.EmailAddress</span>
        </div>

        <div class="mb-3">
            <strong>@Localizer["Gender"]:</strong>
            @switch (Model.Gender)
            {
                case Gender.Male:
                    <span class="badge bg-primary">@Localizer["Male"]</span>
                    break;

                case Gender.Female:
                    <span class="badge bg-danger">@Localizer["Female"]</span>
                    break;

                default:
                    <span class="badge bg-secondary">@Localizer["Unknown"]</span>
                    break;
            }
            @* <span>@Model.Gender</span> *@
        </div>

        <div class="mb-3">
            <strong>@Localizer["Phone"]:</strong>
            <span>@Model.PhoneNumber</span>
        </div>

        <div class="mb-3">
            <strong>@Localizer["HireDate"]:</strong>
            <span>@Model.HireDate.ToString("yyyy-MM-dd")</span>
        </div>

         @* <form asp-action="DeleteConfirmed" method="post">  *@
        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="Id" />

            <div class="d-flex gap-2 mt-4">

                <button type="submit" class="btn btn-danger">
                    @Localizer["Delete"]
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    @Localizer["Cancel"]
                </a>

            </div>

        </form>

    </div>
</div>