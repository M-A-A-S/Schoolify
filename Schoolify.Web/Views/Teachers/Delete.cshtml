@using Schoolify.Common.DTOs.Teacher;
@model TeacherDTO

<h2>Delete Teacher</h2>

<p>Are you sure you want to delete @Model.FirstName + " " + @Model.SecondName + " " + @Model.ThirdName + " " + @Model.ForthName + " " + @Model.EmailAddress + " " + @Model.Gender + " " + @Model.PhoneNumber + " " + @Model.HireDate + " "?</p>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
</form>