@using Schoolify.Common.DTOs.Term
@model TermDTO

@using Schoolify.Common
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

<div class="row g-3">

    <div class="col-md-6">
        <label asp-for="TermNumber"></label>
        <input asp-for="TermNumber" class="form-control" />
        <span asp-validation-for="TermNumber" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="StartDate"></label>
        <input asp-for="StartDate" type="date" class="form-control" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="EndDate"></label>
        <input asp-for="EndDate" type="date" class="form-control" />
        <span asp-validation-for="EndDate" id="end-date-validation" class="text-danger"></span>
    </div>

    <div class="mb-3 col-md-6">
        <label asp-for="SchoolYearId" class="form-label"></label>
        <select asp-for="SchoolYearId"
                class="form-control"
                asp-items="ViewBag.SchoolYears">
            <option selected disabled value="">@Localizer["SelectSchoolYear"]</option>
        </select>
        <span asp-validation-for="SchoolYearId" class="text-danger"></span>
    </div>
</div>