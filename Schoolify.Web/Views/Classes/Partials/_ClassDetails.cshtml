@using Schoolify.Common.DTOs.Class
@model SubjectClassDTO

@using System.Globalization

@using Microsoft.Extensions.Localization
@using Schoolify.Common
@inject IStringLocalizer<SharedResource> Localizer

<div class="row">

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["Subject"]</label>
        <div>
            @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
                        ? @Model?.Subject?.NameAr
                        : @Model?.Subject?.NameEn)
        </div>
    </div>


    <div class="col-md-6">
        <label class="fw-bold">@Localizer["Term"]</label>
        <div>@($"{@Model?.Term?.TermNumber} - {@Model?.Term?.StartDate:yyyy/MM/dd} - {@Model?.Term?.EndDate:yyyy/MM/dd}")</div>
    </div>

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["Section"]</label>
        <div>
            @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
                        ? Model?.Section?.NameAr
                        : Model?.Section?.NameEn)
        </div>
    </div>

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["NameEn"]</label>
        <div>
            @Model.NameEn
        </div>
    </div>

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["NameAr"]</label>
        <div>
            @Model.NameAr
        </div>
    </div>

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["MaxScore"]</label>
        <div>
            @Model.MaxScore
        </div>
    </div>

    <div class="col-12">
        <label class="fw-bold">@Localizer["Teachers"]</label>

        @if (Model.SubjectClassTeachers?.Any() == true)
        {
            <table class="table table-bordered mt-2">
                <thead>
                    <tr>
                        <th>@Localizer["Teacher"]</th>
                        <th>@Localizer["MainTeacher"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.SubjectClassTeachers)
                    {
                        <tr>
                            <td>
                                @($"{item.Teacher?.FirstName} {item.Teacher?.SecondName} {item.Teacher?.ThirdName} {item.Teacher?.ForthName}")
                            </td>
                            <td>
                                @if (item.IsMainTeacher)
                                {
                                    <span class="badge bg-success">
                                        @Localizer["Yes"]
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @Localizer["No"]
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-muted">
                @Localizer["NoTeachersAssigned"]
            </div>
        }
    </div>


</div>