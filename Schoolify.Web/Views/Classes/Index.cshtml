@using Schoolify.Common.DTOs.Class
@model IEnumerable<SubjectClassDTO>

@using Schoolify.Common
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@using System.Globalization

<div class="d-flex align-items-center justify-content-between my-4">
    <h2>@Localizer["Classes"]</h2>

    <a asp-action="Create" class="btn btn-primary">
        <i class="fa fa-plus me-1"></i>
        @Localizer["CreateNew"]
    </a>
</div>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>@Localizer["Subject"]</th>
                <th>@Localizer["Teachers"]</th>
                <th>@Localizer["Term"]</th>
                <th>@Localizer["Section"]</th>
                <th>@Localizer["NameEn"]</th>
                <th>@Localizer["NameAr"]</th>
                <th>@Localizer["MaxScore"]</th>
                <th>@Localizer["Actions"]</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
                                            ? item?.Subject?.NameAr
                                            : item?.Subject?.NameEn)
                    <td>
                    @foreach (var teacher in item.SubjectClassTeachers)
                        {
                            <span class="badge bg-primary me-1">
                                @teacher.Teacher.FirstName @teacher.Teacher.SecondName
                            </span>
                        }
                    </td>
                    <td>
                        @($"{item?.Term?.TermNumber} - {item?.Term?.StartDate:yyyy/MM/dd} - {item?.Term?.EndDate:yyyy/MM/dd}")
                    </td>
                    <td>
                    @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
                                        ? item?.Section?.NameAr
                                        : item?.Section?.NameEn)
                    </td>
                    <td>@item.NameEn</td>
                    <td>@item.NameAr</td>
                    <td>@item.MaxScore</td>


                    <td style="display: flex; gap: 4px">
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-icon btn-outline-primary tooltip-btn"
                           data-tooltip="@Localizer["Edit"]">
                            <i class="fa fa-pen"></i>
                        </a>
                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-icon btn-outline-info tooltip-btn"
                           data-tooltip="@Localizer["Details"]">
                            <i class="fa fa-info"></i>
                        </a>
                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-icon btn-outline-danger tooltip-btn"
                           data-tooltip="@Localizer["Delete"]">
                            <i class="fa fa-trash"></i>
                        </a>
                    </td>
                </tr>
                        }
        </tbody>
    </table>
</div>