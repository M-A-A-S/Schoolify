@using Schoolify.Common.DTOs.Period
@model PeriodDTO

@using System.Globalization

@using Microsoft.Extensions.Localization
@using Schoolify.Common
@inject IStringLocalizer<SharedResource> Localizer

<div class="row">

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["StartTime"]</label>
        <div>@Model.StartTime</div>
    </div>

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["EndTime"]</label>
        <div>@Model.EndTime</div>
    </div>

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["NameEn"]</label>
        <div>@Model.NameEn</div>
    </div>

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["NameAr"]</label>
        <div>@Model.NameAr</div>
    </div>

    <div class="col-md-6">
        <label class="fw-bold">@Localizer["SchoolYear"]</label>
        <div>
            @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
                        ? @Model?.SchoolYear?.NameAr
                        : @Model?.SchoolYear?.NameEn)
        </div>
    </div>

</div>