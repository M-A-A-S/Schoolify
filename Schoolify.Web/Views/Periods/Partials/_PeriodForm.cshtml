@using Schoolify.Common.DTOs.Period
@model PeriodDTO

@using Schoolify.Common
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

<div class="row g-3">

    <div class="col-md-6">
        <label asp-for="StartTime"></label>
        <input asp-for="StartTime" type="time" class="form-control" />
        <span asp-validation-for="StartTime" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="EndTime"></label>
        <input asp-for="EndTime" type="time" class="form-control" />
        <span asp-validation-for="EndTime" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="NameEn"></label>
        <input asp-for="NameEn"  class="form-control" />
        <span asp-validation-for="NameEn" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="NameAr"></label>
        <input asp-for="NameAr" class="form-control" />
        <span asp-validation-for="NameAr" class="text-danger"></span>
    </div>

    <div class="mb-3 col-md-6">
        <label asp-for="SchoolYearId" class="form-label"></label>
        <select asp-for="SchoolYearId"
                class="form-control"
                asp-items="ViewBag.SchoolYears">
            <option selected disabled value="">@Localizer["SelectSchoolYear"]</option>
        </select>
        <span asp-validation-for="SchoolYearId" class="text-danger"></span>
    </div>
</div>